# Caddy in front of the OdooPLM demo instance.
# ODOOPLM_HOSTNAME and ACME_EMAIL come from the environment of the caddy
# service; see deploy/compose.proxy.yaml.
{
	email {$ACME_EMAIL}
}

{$ODOOPLM_HOSTNAME} {
	encode zstd gzip

	# CAD documents are big: do not let the proxy cut the uploads short.
	request_body {
		max_size 1GB
	}

	# The database manager creates and drops databases. The entrypoint already
	# builds the database on boot, so nothing here needs it — and on a public
	# server it is the first thing that gets probed. Delete this block if you
	# want to restore backups through the browser.
	@dbmanager path /web/database/*
	respond @dbmanager "Disabled on this server" 403

	# Chatter and 3D viewer. Served by the gevent process on 8072 — which only
	# exists when `workers` is greater than 0 in config/odoo.conf. On a threaded
	# server (workers = 0) delete this block: 8069 handles the websocket itself.
	@websocket path /websocket /longpolling/*
	reverse_proxy @websocket odoo:8072

	reverse_proxy odoo:8069 {
		# Long CAD conversions and big BOM imports.
		transport http {
			read_timeout 900s
			write_timeout 900s
		}
	}

	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
