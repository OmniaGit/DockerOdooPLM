# .env for a demo server that rebuilds itself every Sunday night.
#   cp deploy/env.demo-server.example .env    (then edit the CHANGE-ME)
#
# TLS and the public hostname are not handled here: this stack expects your own
# reverse proxy (nginx, Traefik, HAProxy…) in front of it.

# --- image -------------------------------------------------------------------
# The -demo tag installs plm_demo on first boot: the LSU-100 sample product,
# its BOMs, documents, previews and 3D markups.
ODOOPLM_IMAGE=ghcr.io/omniagit/odooplm:20.0-demo

# --- ports -------------------------------------------------------------------
# Bound to loopback: your reverse proxy is what the internet talks to, and it
# reaches Odoo here. Point its upstream at 127.0.0.1:8069, and /websocket at
# 127.0.0.1:8072.
# Drop the 127.0.0.1: prefix only if you really want Odoo itself exposed.
ODOO_PORT=127.0.0.1:8069
ODOO_WEBSOCKET_PORT=127.0.0.1:8072

# --- database ----------------------------------------------------------------
POSTGRES_USER=odoo
# CHANGE-ME: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE-ME

# --- first boot --------------------------------------------------------------
ODOOPLM_DB=odooplm
# 1 loads Odoo's demo data, which is what creates the admin / admin login.
# Never on a production instance; exactly right on a demo that is wiped weekly.
ODOOPLM_WITH_DEMO=1
# Modules: left unset on purpose so the -demo image decides. Uncomment this if
# the reset ever reports "plm_demo is not installed" — that happens with images
# published before ODOOPLM_DEFAULT_MODULES existed, whose list compose shadows.
#ODOOPLM_INIT_MODULES=plm,plm_spare,plm_web_3d,plm_demo
# Extra language, e.g. it_IT
ODOOPLM_INIT_LANG=
ODOOPLM_AUTO_INIT=1

# --- compose -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=odooplm20
