# .env for a public demo server that rebuilds itself every Sunday night.
#   cp deploy/env.demo-server.example .env    (then edit the three CHANGE-ME)

# --- image -------------------------------------------------------------------
# The -demo tag installs plm_demo on first boot: the LSU-100 sample product,
# its BOMs, documents, previews and 3D markups.
ODOOPLM_IMAGE=ghcr.io/omniagit/odooplm:19.0-demo

# --- ports -------------------------------------------------------------------
# Bound to loopback: the internet reaches Odoo through Caddy only, which talks
# to the container over the compose network. Keeps the ports usable for local
# debugging (ssh -L 8069:127.0.0.1:8069 user@server).
ODOO_PORT=127.0.0.1:8069
ODOO_WEBSOCKET_PORT=127.0.0.1:8072

# --- reverse proxy -----------------------------------------------------------
# CHANGE-ME: the public name pointing at this server. Its A/AAAA record must
# already resolve here, or Caddy cannot obtain a certificate.
ODOOPLM_HOSTNAME=plm-demo.example.com
# CHANGE-ME: where Let's Encrypt sends expiry warnings.
ACME_EMAIL=info@example.com

# Makes every `docker compose` command — including the weekly reset — include
# the proxy without having to pass -f twice.
COMPOSE_FILE=compose.yaml:deploy/compose.proxy.yaml

# --- database ----------------------------------------------------------------
POSTGRES_USER=odoo
# CHANGE-ME: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE-ME

# --- first boot --------------------------------------------------------------
ODOOPLM_DB=odooplm
# 1 loads Odoo's demo data, which is what creates the admin / admin login.
# Never on a production instance; exactly right on a demo that is wiped weekly.
ODOOPLM_WITH_DEMO=1
# Modules: left unset on purpose so the -demo image decides. Uncomment this if
# the reset ever reports "plm_demo is not installed" — that happens with images
# published before ODOOPLM_DEFAULT_MODULES existed, whose list compose shadows.
#ODOOPLM_INIT_MODULES=plm,plm_spare,plm_web_3d,plm_demo
# Extra language, e.g. it_IT
ODOOPLM_INIT_LANG=
ODOOPLM_AUTO_INIT=1

# --- compose -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=odooplm19
