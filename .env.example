# Copy this file to .env and adapt it: docker compose reads .env automatically.
# Every value below is the default, so an empty .env works as well.

# --- image -------------------------------------------------------------------
# Published images:
#   ghcr.io/omniagit/odooplm:18.0        full  (with the CAD conversion stack)
#   ghcr.io/omniagit/odooplm:18.0-slim   slim  (without cadquery/OCP/vtk)
#   omniasolutions/odooplm:18.0          same images on Docker Hub
ODOOPLM_IMAGE=ghcr.io/omniagit/odooplm:18.0

# Used only by `docker compose build`:
#   VARIANT=full keeps plm_automated_convertion working, slim is ~1.5 GB smaller
ODOOPLM_VARIANT=full
# Branch, tag or commit of https://github.com/OmniaGit/odooplm to package
ODOOPLM_REF=18.0

# --- ports -------------------------------------------------------------------
ODOO_PORT=8069
ODOO_WEBSOCKET_PORT=8072

# --- database ----------------------------------------------------------------
POSTGRES_USER=odoo
# CHANGE THIS on anything reachable from outside your machine
POSTGRES_PASSWORD=odoo

# --- first boot --------------------------------------------------------------
# Database created automatically the first time the stack starts.
ODOOPLM_DB=odooplm
# Comma separated modules installed in that database. Some useful extras:
#   plm,plm_web_3d,plm_engineering,plm_spare,plm_pack_and_go,plm_web_revision
ODOOPLM_INIT_MODULES=plm
# 1 to load the Odoo demo data (handy to play with, never in production)
ODOOPLM_WITH_DEMO=0
# Extra language to load at creation time, e.g. it_IT
ODOOPLM_INIT_LANG=
# 0 to disable the automatic database creation entirely
ODOOPLM_AUTO_INIT=1

# --- compose -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=odooplm18
